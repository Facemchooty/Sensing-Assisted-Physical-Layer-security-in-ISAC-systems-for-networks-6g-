function gain = mimoGain(bsPos, targetPos, Nt, dAnt, lambda)
    dv  = targetPos(:) - bsPos(:);
    az  = atan2(dv(2), dv(1));
    sv  = exp(1j*2*pi*dAnt*(0:Nt-1)'*sin(az));
    sv  = sv / norm(sv);
    gain = norm(sv)^2 * Nt;
end