function [users,obj,eve] = stepMobilityAll(users,obj,eve,room,dt)
    for i=1:numel(users)
        users(i).pos = users(i).pos + users(i).vel*dt;
        [users(i).pos, users(i).vel] = bounce2D(users(i).pos, users(i).vel, room);
    end
    for i=1:numel(obj)
        obj(i).pos = obj(i).pos + obj(i).vel*dt;
        [obj(i).pos, obj(i).vel] = bounce2D(obj(i).pos, obj(i).vel, room);
    end
    for i=1:numel(eve)
        eve(i).pos = eve(i).pos + eve(i).vel*dt;
        [eve(i).pos, eve(i).vel] = bounce2D(eve(i).pos, eve(i).vel, room);
    end
end
function [rngEst, z, rxGrid] = senseRangeAndSlowSample(...
     txTime, txGrid, bsPos, obj, fc, Fs, Tframe, Nfft, cpLen, NsSym, fftBins)
 
     c = 3e8;
     lambda = c/fc;
     x = txTime(:);
     N = numel(x);
     symLen = Nfft + cpLen;
 
     rngEst = nan(1, numel(obj));
     z      = nan(1, numel(obj));
 
     n = (0:N-1).';
     t = n/Fs;
 
     % Αθροιστικό echo από όλα τα objects
     echoTotal = zeros(N, 1);
 
     for i = 1:numel(obj)
         d   = norm(obj(i).pos - bsPos);
         tau = 2*d/c;
         n0  = round(tau*Fs);
         if n0 >= N, continue; end
 
         u_los = (obj(i).pos - bsPos) / max(d, 1e-9);
         vRad  = dot(obj(i).vel, u_los);
         fD    = 2*vRad/lambda;
 
         echo = zeros(N,1);
         echo(n0+1:end) = x(1:end-n0) .* exp(1j*2*pi*fD*t(1:end-n0));
         phi = 0;
         if isfield(obj(i),'phi'), phi = obj(i).phi; end
         echo = echo * (0.1*obj(i).rcs) * exp(1j*phi);
 
         echoTotal = echoTotal + echo;
 
         % xcorr για range (παλιό)
         r = xcorr(echo, x);
         [~,ix] = max(abs(r));
         lag = ix - N;
         tauHat = abs(lag)/Fs;
         rngEst(i) = (tauHat*c)/2;
         z(i) = r(ix);
     end
 
    % Φτιάξε rxGrid από το αθροιστικό echo [Nsc x NsSym]
    symLen = Nfft + cpLen;
    need   = symLen * NsSym;
    if numel(echoTotal) < need
        echoTotal = [echoTotal; zeros(need - numel(echoTotal), 1)];
    end
    Y      = reshape(echoTotal(1:need), symLen, NsSym);
    Y      = Y(cpLen+1:end, :);
    Xhat   = fftshift(fft(Y, Nfft, 1), 1);
    rxGrid = Xhat(fftBins, :);
 end
 function [rdMap, range_axis, doppler_axis] = senseRangeDoppler2D(...
    txGrid, rxGrid, Nfft, Nsc, fftBins, deltaF, NsSym, Tframe, cpLen, Fs)
    c = 3e8;

    % Βήμα 1: Channel ratio
    H = rxGrid ./ (txGrid + 1e-12);   % [Nsc x NsSym]

    % Βήμα 2: IFFT κατά subcarrier → delay domain (range)
    H_full = zeros(Nfft, NsSym);
    H_full(fftBins, :) = H;
    h_delay = ifft(H_full, Nfft, 1);  % [Nfft x NsSym]

    % Βήμα 3: FFT κατά σύμβολο → Doppler domain
    rdMap = fft(h_delay, NsSym, 2);   % [Nfft x NsSym]
    rdMap = fftshift(rdMap, 2);
   %  rdMap = abs(rdMap).^2;   %%%% λαθος

    % Άξονες
    range_res    = c / (2 * Nfft * deltaF);
    range_axis   = (0:Nfft-1) * range_res;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
    Tsym = (Nfft + cpLen) / Fs;  %%%% λαθοςστ
    doppler_axis = (-NsSym/2 : NsSym/2-1) / (NsSym * Tsym);
end

function [bestBS, bestSR] = chooseSecureBS(userPos, eve, BS, Nt, dAnt, lambda, SNRlin)
   
bestBS = 1; bestSR = 0;
    for b = 1:numel(BS)
        % jammer = ο πλησιέστερος άλλος BS
        others = setdiff(1:numel(BS), b);
        [~, jIdx] = min(arrayfun(@(j) norm(BS(j).pos - userPos), others));
        %jamBS = others(jIdx);
        % sr = secrecyScore(b, userPos, eve, BS, beamAz, ...
        %           beamwidthDeg, Gmain_dB, Gside_dB, SNRlin);
         sr = secrecyScore(b, userPos, eve, BS, Nt, dAnt, lambda, SNRlin);
        if sr > bestSR
            bestSR = sr; bestBS = b;
        end
    end

end


function SR = secrecyScore(txBS, userPos, eve, BS, Nt, dAnt, lambda, SNRlin)

    % Signal προς χρήστη από txBS
    txAz  = azimuthDeg2D(BS(txBS).pos, userPos); 
    Gtx_u = mimoGain(BS(txBS).pos, userPos, Nt, dAnt, lambda);
    du      = norm(userPos - BS(txBS).pos);
    sigU    = Gtx_u / max(du^2, 1e-6);

    % Αθροιστικός θόρυβος στον χρήστη από ΟΛΟΥΣ τους άλλους BS
    intU = 0;
for jb = 1:numel(BS)
    if jb == txBS, continue; end
    % Jammer στρέφεται ΠΡΟΣ την πλησιέστερη Eve
    [~, eIdx] = min(arrayfun(@(e) norm(eve(e).pos - BS(jb).pos), 1:numel(eve)));
    
    Gjam_u = mimoGain(BS(jb).pos, userPos, Nt, dAnt, lambda);
    dju    = norm(userPos - BS(jb).pos);
    
    intU   =intU + 0.1*Gjam_u / max(dju^2, 1e-6);
end

    Clegit = log2(1 + (SNRlin*sigU) / (1 + SNRlin*intU));

    % Για κάθε Eve
    CeveMax = 0;
    for e = 1:numel(eve)
        az_e_tx = azimuthDeg2D(BS(txBS).pos, eve(e).pos);
        Gtx_e = mimoGain(BS(txBS).pos, eve(e).pos, Nt, dAnt, lambda);
        de    = norm(eve(e).pos - BS(txBS).pos);
        sigE  = Gtx_e / max(de^2, 1e-6);

        % Αθροιστικός θόρυβος στην Eve από ΟΛΟΥΣ τους άλλους BS
      intE = 0;
    for jb = 1:numel(BS)
    if jb == txBS, continue; end
    Gjam_e = mimoGain(BS(jb).pos, eve(e).pos, Nt, dAnt, lambda);
    dje    = norm(eve(e).pos - BS(jb).pos);
    intE   = intE + 0.1*Gjam_e / max(dje^2, 1e-6);
    end
        Ce      = log2(1 + (SNRlin*sigE) / (1 + SNRlin*intE));
        CeveMax = max(CeveMax, Ce);
    end

    SR = max(Clegit - CeveMax, 0);
end

